---
import SiteLayout from '~/layouts/SiteLayout.astro';
import ReleaseFilter from '~/components/islands/ReleaseFilter.tsx';
import { loadProjects } from '~/lib/manifest/load';
import { flattenReleases, projectReleaseSummary } from '~/lib/releases/transform';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { SITE } from '~/lib/site';
import { withBase } from '~/lib/urls';

const projects = loadProjects();
const releaseIndex = getReleaseIndex();
const summaries = projects.map((project) =>
  projectReleaseSummary(project, releaseIndex.data, releaseIndex.source),
);
const releases = flattenReleases(summaries).filter((entry) => !entry.archived);
const projectOptions = projects
  .filter((project) => project.status !== 'archived' && project.packages.length > 0)
  .map((project) => ({ id: project.id, name: project.name }));

function formatDate(value: string | null): string {
  if (!value) {
    return 'Unknown date';
  }
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? 'Unknown date'
    : date.toLocaleDateString('en-GB', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
}
---

<SiteLayout
  title={`Releases — ${SITE.fullName}`}
  description="GitHub and NuGet release information for every Purview-Dev project."
>
  <div class="pv-container py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Releases</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Releases</h1>
      <p class="mt-4 text-lg text-muted">
        Recent GitHub releases across the Purview-Dev product family, alongside
        the latest stable and prerelease NuGet versions for every package.
      </p>
    </div>

    <div class="mt-8">
      <ReleaseFilter client:visible projects={projectOptions} />
    </div>

    <div class="mt-8 space-y-3">
      {
        releases.length === 0 && (
          <p class="rounded-lg border border-border bg-surface p-6 text-muted">
            No release data is currently available.
            {
              releaseIndex.source === 'fixture' && (
                <> This build is using committed sample fixtures; run `just fetch-releases` for live data.</>
              )
            }
          </p>
        )
      }
      {
        releases.map((release) => (
          <article
            data-release-project={release.projectId}
            data-release-prerelease={release.prerelease}
            class="pv-card flex flex-col gap-2 p-5 sm:flex-row sm:items-center sm:justify-between"
          >
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <a
                  href={withBase(`/projects/${release.projectId}/`)}
                  class="text-sm font-semibold text-accent hover:underline"
                >
                  {release.projectName}
                </a>
                {
                  release.prerelease && (
                    <span class="rounded-full border border-warning/40 bg-warning/10 px-2 py-0.5 text-xs text-warning">
                      prerelease
                    </span>
                  )
                }
              </div>
              <a
                href={release.url}
                rel="noopener noreferrer"
                target="_blank"
                class="mt-1 block truncate font-mono text-sm font-medium hover:underline"
              >
                {release.tagName}
              </a>
            </div>
            <div class="shrink-0 text-sm text-muted sm:text-right">
              <time datetime={release.publishedAt ?? undefined}>{formatDate(release.publishedAt)}</time>
            </div>
          </article>
        ))
      }
    </div>

    <section class="mt-16">
      <h2 class="text-xl font-semibold">Package versions</h2>
      <p class="mt-2 max-w-2xl text-muted">
        The latest stable and prerelease versions of each NuGet package, sourced
        from the NuGet API at build time.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead class="border-b border-border bg-surface">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Project</th>
              <th scope="col" class="px-4 py-3 font-semibold">Package</th>
              <th scope="col" class="px-4 py-3 font-semibold">Stable</th>
              <th scope="col" class="px-4 py-3 font-semibold">Prerelease</th>
            </tr>
          </thead>
          <tbody>
            {
              summaries.map((summary) =>
                summary.packages.map((pkg) => (
                  <tr class="border-b border-border last:border-0">
                    <td class="px-4 py-3">
                      <a
                        href={withBase(`/projects/${summary.projectId}/`)}
                        class="pv-link"
                      >
                        {summary.projectName}
                      </a>
                    </td>
                    <td class="px-4 py-3">
                      <a
                        href={pkg.nugetUrl}
                        rel="noopener noreferrer"
                        target="_blank"
                        class="pv-link break-all"
                      >
                        {pkg.packageId}
                      </a>
                    </td>
                    <td class="px-4 py-3 font-mono text-xs">
                      {pkg.latestStable ?? <span class="text-muted">—</span>}
                    </td>
                    <td class="px-4 py-3 font-mono text-xs">
                      {pkg.latestPrerelease ?? <span class="text-muted">—</span>}
                    </td>
                  </tr>
                )),
              )
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-muted">
        Release data retrieved on {releaseIndex.data.retrievedAt.slice(0, 10)} ({releaseIndex.source} source).
      </p>
    </section>
  </div>
</SiteLayout>