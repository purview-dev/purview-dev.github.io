---
import SiteLayout from '~/layouts/SiteLayout.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ProjectFilter from '~/components/islands/ProjectFilter.tsx';
import { loadProjects } from '~/lib/manifest/load';
import { SITE } from '~/lib/site';

const projects = loadProjects();
const categories = [...new Set(projects.map((project) => project.category))].toSorted();
const statuses = ['stable', 'preview', 'archived'];
---

<SiteLayout
  title={`Projects — ${SITE.fullName}`}
  description="The Purview-Dev product family: event sourcing, telemetry, validation, source generators, and build automation for .NET."
>
  <div class="pv-container py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Catalogue</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Projects</h1>
      <p class="mt-4 text-lg text-muted">
        The complete Purview-Dev product family — open source, MIT licensed, and
        published to NuGet. Every project is documented and actively developed.
      </p>
    </div>

    <div class="mt-8">
      <ProjectFilter client:visible categories={categories} statuses={statuses} />
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <div
            data-project-id={project.id}
            data-category={project.category}
            data-status={project.status}
            data-search={`${project.name} ${project.shortDescription} ${project.category} ${project.status}`.toLowerCase()}
          >
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </div>
</SiteLayout>