---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { SITE } from '~/lib/site';
import { withBase } from '~/lib/urls';
---

<SiteLayout
  title={`Page not found — ${SITE.fullName}`}
  description="The page you were looking for could not be found."
>
  <div class="pv-container flex flex-col items-center py-24 text-center md:py-32">
    <p class="pv-chip mb-6 border-brand/30 bg-brand/5 text-brand">404</p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
      This page seems to have evaporated.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">
      The URL you followed does not exist on {SITE.domain}. The beaker may have
      bubbled over — or the link may be out of date.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href={withBase('/')}
        class="rounded-lg bg-brand px-5 py-2.5 font-medium text-white transition-colors hover:bg-brand-emphasis"
      >
        Back to the homepage
      </a>
      <a
        href={withBase('/projects/')}
        class="rounded-lg border border-border bg-surface px-5 py-2.5 font-medium transition-colors hover:border-brand/40"
      >
        Browse projects
      </a>
      <a
        href={withBase('/docs/')}
        class="rounded-lg px-5 py-2.5 font-medium text-accent underline decoration-1 underline-offset-4 hover:decoration-2"
      >
        Documentation
      </a>
    </div>
  </div>
</SiteLayout>