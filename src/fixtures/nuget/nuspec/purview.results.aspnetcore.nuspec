<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.Results.AspNetCore</id>
    <version>1.0.2</version>
    <title>Purview Results ASP.NET Core</title>
    <authors>Kieron Lanning</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/results/</projectUrl>
    <description>Maps Purview.Results results onto ASP.NET Core responses, including ProblemDetails for expected failures.</description>
    <copyright>Copyright © 2026 Purview-Dev</copyright>
    <tags>results result aspnetcore problemdetails minimal-api purview</tags>
    <repository type="git" url="https://github.com/purview-dev/results" branch="refs/heads/main" commit="15358bfd9dbd673e183c092df04cf48717ee5198" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Purview.Results" version="1.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="Purview.Results" version="1.0.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
      <group targetFramework="net11.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
</package>