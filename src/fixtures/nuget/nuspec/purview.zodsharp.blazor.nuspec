<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.ZodSharp.Blazor</id>
    <version>3.0.0-prerelease.2</version>
    <authors>ZodSharp Contributors,Purview-Dev Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/zodsharp/</projectUrl>
    <description>Blazor integration for ZodSharp: validates EditForm models with ZodSharp on Blazor Server, Blazor
			WebAssembly and Auto render mode, through the standard DataAnnotationsValidator or the full-fidelity
			ZodValidator, and maps API validation problems back onto form fields.</description>
    <tags>zod validation schema blazor webassembly forms</tags>
    <repository type="git" url="https://github.com/purview-dev/zodsharp" branch="refs/heads/main" commit="d0dbc74417d4445226a58ef96464d4d3519bd3c4" />
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="Purview.ZodSharp.Extensions.Validation" version="3.0.0-prerelease.2" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp.Http" version="3.0.0-prerelease.2" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp" version="3.0.0-prerelease.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Components.Forms" version="11.0.0-rc.3.26522.148" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Components.Web" version="11.0.0-rc.3.26522.148" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="11.0.0-rc.3.26522.148" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Validation" version="11.0.0-rc.3.26522.148" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>