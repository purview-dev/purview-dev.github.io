<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.SourceGeneratorFramework</id>
    <version>1.0.0</version>
    <authors>Purview Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/sourcegenerator-framework/</projectUrl>
    <description>Purview SourceGeneratorFramework libraries for building and testing incremental C# source generators.</description>
    <repository type="git" url="https://github.com/purview-dev/sourcegenerator-framework" branch="refs/heads/main" commit="28d5da49bf29c73f80ee0d9a30fe9191bc58f3fb" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.CodeAnalysis.Analyzers" version="5.9.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CodeAnalysis.CSharp" version="5.9.0" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Reflection.Metadata" version="10.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="any/netstandard2.0/Packaging.md" buildAction="None" />
    </contentFiles>
  </metadata>
</package>