<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Purview.ValueObjects</id>
    <version>1.0.0</version>
    <title>Purview Value Objects</title>
    <authors>Kieron Lanning</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/value-objects/</projectUrl>
    <description>Source-generated scalar and complex value objects for .NET. Brings F#-style single-case types to C# with Create/Hydrate factories, normalization, validation, equality, comparison, implicit conversions, and JSON serialization for DTOs, Entity Framework, and domain models.</description>
    <copyright>Copyright © 2026 Purview-Dev</copyright>
    <tags>purview dotnet value-objects value-object scalar source-generator domain-driven-design dto serialization json entity-framework</tags>
    <repository type="git" url="https://github.com/purview-dev/value-objects.git" branch="refs/heads/main" commit="0260753a6fcb37fe4297a7c919ecf96f27b6ac37" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework="net11.0" />
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
    </dependencies>
  </metadata>
</package>