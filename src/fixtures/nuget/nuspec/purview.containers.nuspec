<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.Containers</id>
    <version>1.0.0-prerelease.6</version>
    <authors>Purview</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/purview-dev/containers</projectUrl>
    <description>Purview.Containers: the umbrella package. Brings the abstractions (Purview.Containers.Core) and both backends (WSL Containers and Docker), so one reference runs the same tests on WSLC on Windows and Docker everywhere else.</description>
    <tags>containers testing integration testcontainers docker wsl wslc bundle</tags>
    <repository type="git" url="https://github.com/purview-dev/containers" branch="refs/heads/main" commit="49a9746e8465558f46ebe8aa54ac2a9a22c9ee50" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Purview.Containers.Core" version="1.0.0-prerelease.6" exclude="Build,Analyzers" />
        <dependency id="Purview.Containers.Docker" version="1.0.0-prerelease.6" exclude="Build,Analyzers" />
        <dependency id="Purview.Containers.Wsl" version="1.0.0-prerelease.6" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Telemetry.Abstractions" version="10.10.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>