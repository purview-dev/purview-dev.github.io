<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.Results.ZodSharp.AspNetCore</id>
    <version>1.0.0</version>
    <title>Purview Results ZodSharp ASP.NET Core</title>
    <authors>Kieron Lanning</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/results/</projectUrl>
    <description>Maps Purview result failures that carry ZodSharp validation errors onto ASP.NET Core HttpValidationProblemDetails responses.</description>
    <copyright>Copyright © 2026 Purview-Dev</copyright>
    <tags>results result aspnetcore problemdetails validation zod purview</tags>
    <repository type="git" url="https://github.com/purview-dev/results" branch="refs/heads/main" commit="fbf0f23aca7dc0bdb08b9f4d0380070c5079e343" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Purview.Results.AspNetCore" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Purview.Results.ZodSharp" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp.AspNetCore" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="Purview.Results.AspNetCore" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Purview.Results.ZodSharp" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp.AspNetCore" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
      <group targetFramework="net11.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
</package>