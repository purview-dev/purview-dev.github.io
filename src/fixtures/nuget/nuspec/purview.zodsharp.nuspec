<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.ZodSharp</id>
    <version>2.1.0</version>
    <authors>ZodSharp Contributors,Purview-Dev Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/zodsharp/</projectUrl>
    <description>A high-performance C# port of Zod schema validation library.
			Features zero-allocation validation, struct-based rules, fluent API,
			and source generator support for maximum performance.</description>
    <tags>zod validation schema</tags>
    <repository type="git" url="https://github.com/purview-dev/zodsharp" branch="refs/heads/main" commit="cb739a2179e878088b9a51fafc871570dabaccfe" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.13" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.13" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0" />
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="8.0.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="8.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="9.0.20" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="9.0.20" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>