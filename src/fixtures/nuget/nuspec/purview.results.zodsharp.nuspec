<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Purview.Results.ZodSharp</id>
    <version>1.0.0</version>
    <title>Purview Results ZodSharp</title>
    <authors>Kieron Lanning</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>purview-logo-light.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://purview.dev/projects/results/</projectUrl>
    <description>Bridges ZodSharp ValidationResult&lt;T&gt; values into Purview.Results, so validation outcomes flow through the result pipeline as ordinary error values instead of exceptions.</description>
    <copyright>Copyright © 2026 Purview-Dev</copyright>
    <tags>results result validation zod zodsharp purview</tags>
    <repository type="git" url="https://github.com/purview-dev/results" branch="refs/heads/main" commit="fbf0f23aca7dc0bdb08b9f4d0380070c5079e343" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Purview.Results" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="Purview.Results" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="Purview.ZodSharp" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>