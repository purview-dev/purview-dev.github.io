---
import { skillEntryPath } from '~/lib/skills';
import { withBase } from '~/lib/urls';

interface Props {
  projectId: string;
  skills: { name: string; description: string | null; files: number }[];
}

const { projectId, skills } = Astro.props;
---

<ul class="divide-y divide-border rounded-xl border border-border">
  {
    skills.map((skill) => (
      <li class="flex flex-col gap-1 p-4 sm:flex-row sm:items-baseline sm:justify-between">
        <div>
          <a
            href={withBase(skillEntryPath(projectId, skill.name))}
            class="pv-link font-mono text-sm"
          >
            {skill.name}
          </a>
          {skill.description && (
            <p class="mt-1 max-w-2xl text-sm text-muted">{skill.description}</p>
          )}
        </div>
        <span class="shrink-0 text-xs text-muted">
          {skill.files} file{skill.files === 1 ? '' : 's'}
        </span>
      </li>
    ))
  }
</ul>
