---
import StatusBadge from '~/components/StatusBadge.astro';
import type { ProjectPackageVersions } from '~/lib/releases/live';
import {
  prereleaseTooltip,
  projectTooltip,
} from '~/lib/releases/live';
import type { ProjectVersionRollup } from '~/lib/releases/transform';
import { withBase } from '~/lib/urls';

interface Props {
  /** One row per active project, rolled up from that project's NuGet packages. */
  rows: ProjectVersionRollup[];
  /** The build-time versions behind each row, so the browser can recompute it live (ADR 0008). */
  packages: ProjectPackageVersions[];
}

const { rows, packages } = Astro.props;

function formatDate(value: string | null): string {
  if (!value) {
    return 'Unknown date';
  }
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? 'Unknown date'
    : date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
}

/** The per-project package versions the browser refresh recomputes each row from. */
const livePayload = {
  projects: rows.map((row) => ({
    projectId: row.projectId,
    packages: packages
      .filter((pkg) => pkg.projectId === row.projectId)
      .map((pkg) => ({ id: pkg.packageId, stable: pkg.stable, prerelease: pkg.prerelease })),
  })),
};
---

{
  rows.length === 0 ? (
    <p class="border-border bg-surface text-muted rounded-lg border p-6">
      No release data is currently available.
    </p>
  ) : (
    <div class="pv-card overflow-hidden overflow-x-auto">
      <table class="w-full min-w-[44rem] text-left text-sm">
        <thead class="border-border bg-surface/80 border-b backdrop-blur">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold">
              Project
            </th>
            <th scope="col" class="px-4 py-3 font-semibold">
              Stable
            </th>
            <th scope="col" class="px-4 py-3 font-semibold">
              Prerelease
            </th>
            <th scope="col" class="px-4 py-3 font-semibold">
              Latest release
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr
              class="border-border hover:bg-surface/60 border-b last:border-0"
              data-project-id={row.projectId}
              data-project-version={row.stableVersion ?? row.prereleaseVersion ?? ''}
            >
              <td class="px-4 py-3">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={withBase(`/projects/${row.projectId}/`)} class="pv-link font-medium">
                    {row.projectName}
                  </a>
                  <StatusBadge status={row.status} />
                  <span class="pv-chip" data-package-count title={projectTooltip(row)}>
                    {row.packageCount} package{row.packageCount === 1 ? '' : 's'}
                  </span>
                </div>
              </td>
              <td class="px-4 py-3">
                <span
                  class="pv-version-badge"
                  data-tone="stable"
                  data-version={row.stableVersion ?? ''}
                  data-version-stable
                >
                  {row.stableVersion ?? '—'}
                </span>
              </td>
              <td class="px-4 py-3">
                <span
                  class="pv-version-badge"
                  data-tone="prerelease"
                  data-version={row.prereleaseVersion ?? ''}
                  data-version-prerelease
                  title={prereleaseTooltip(row)}
                >
                  {row.prereleaseVersion ?? '—'}
                </span>
              </td>
              <td class="text-muted px-4 py-3 text-xs">
                {row.latestRelease ? (
                  <a
                    href={row.latestRelease.htmlUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="pv-link font-mono whitespace-nowrap"
                  >
                    {row.latestRelease.tagName}
                  </a>
                ) : (
                  <span class="text-muted">—</span>
                )}
                {row.latestRelease?.publishedAt && (
                  <span class="ml-2 whitespace-nowrap">
                    {formatDate(row.latestRelease.publishedAt)}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

<p class="text-muted mt-3 text-xs" data-version-status hidden aria-live="polite"></p>

<script type="application/json" id="pv-version-data" set:html={JSON.stringify(livePayload).replace(/</g, '\\u003c')} />

<script>
  import {
    isStale,
    latestFromVersions,
    mergeVersionPair,
    prereleaseTooltip,
    projectTooltip,
    readLiveVersions,
    refreshLiveVersions,
    rollupPackageVersions,
    versionStatusMessage,
    type LiveVersions,
  } from '~/lib/releases/live';

  interface SnapshotPackage {
    id: string;
    stable: string | null;
    prerelease: string | null;
  }
  interface SnapshotProject {
    projectId: string;
    packages: SnapshotPackage[];
  }

  const dataElement = document.getElementById('pv-version-data');
  const payload = dataElement?.textContent
    ? (JSON.parse(dataElement.textContent) as { projects: SnapshotProject[] })
    : null;

  const setVersion = (element: Element | null, version: string | null) => {
    if (!(element instanceof HTMLElement)) {
      return;
    }
    element.dataset.version = version ?? '';
    element.textContent = version ?? '—';
  };

  const setTooltip = (element: Element | null, tooltip: string | undefined) => {
    if (!(element instanceof HTMLElement)) {
      return;
    }
    if (tooltip) {
      element.title = tooltip;
    } else {
      element.removeAttribute('title');
    }
  };

  if (payload) {
    const statusElement = document.querySelector<HTMLElement>('[data-version-status]');

    // Recompute each row from the package-level versions, so a newer version of
    // any package moves the project's rolled-up stable/prerelease cell.
    const apply = (live: LiveVersions | null) => {
      for (const project of payload.projects) {
        const row = document.querySelector<HTMLElement>(
          `[data-project-id="${project.projectId}"]`,
        );
        if (!row) {
          continue;
        }
        const pairs = project.packages.map((pkg) => {
          const current = { stable: pkg.stable, prerelease: pkg.prerelease };
          const versions = live?.versions[pkg.id];
          return versions ? mergeVersionPair(current, latestFromVersions(versions)) : current;
        });
        const rollup = rollupPackageVersions(pairs);
        const tooltipRow = { ...rollup, packageCount: project.packages.length };

        setVersion(row.querySelector('[data-version-stable]'), rollup.stableVersion);
        setVersion(row.querySelector('[data-version-prerelease]'), rollup.prereleaseVersion);
        setTooltip(row.querySelector('[data-version-prerelease]'), prereleaseTooltip(tooltipRow));
        setTooltip(row.querySelector('[data-package-count]'), projectTooltip(tooltipRow));
        row.dataset.projectVersion = rollup.stableVersion ?? rollup.prereleaseVersion ?? '';
      }
    };

    const showStatus = (status: string, live: LiveVersions | null) => {
      if (!statusElement) {
        return;
      }
      statusElement.textContent = versionStatusMessage(status, live);
      statusElement.hidden = statusElement.textContent === '';
    };

    const packageIds = [
      ...new Set(payload.projects.flatMap((project) => project.packages.map((pkg) => pkg.id))),
    ];

    const stored = readLiveVersions();
    apply(stored);
    if (stored && !isStale(stored)) {
      showStatus('stored', stored);
    } else {
      showStatus('checking', null);
      void refreshLiveVersions(packageIds, stored).then((refreshed) => {
        if (refreshed) {
          apply(refreshed);
          showStatus('live', refreshed);
        } else {
          showStatus(stored ? 'stored' : 'unavailable', stored);
        }
      });
    }
  }
</script>
