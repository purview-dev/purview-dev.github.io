---
import StatusBadge from '~/components/StatusBadge.astro';
import type { ProjectVersionRollup } from '~/lib/releases/transform';
import { withBase } from '~/lib/urls';

interface Props {
  /** One row per active project, rolled up from that project's NuGet packages. */
  rows: ProjectVersionRollup[];
}

const { rows } = Astro.props;

function formatDate(value: string | null): string {
  if (!value) {
    return 'Unknown date';
  }
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? 'Unknown date'
    : date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
}

/**
 * Explanation for a blanked prerelease cell (or for packages that trail the
 * headline version), so the suppressed detail stays discoverable on hover.
 */
function prereleaseTooltip(row: ProjectVersionRollup): string | undefined {
  if (row.prereleaseVersion) {
    return row.laggingPackageCount > 0
      ? `${row.laggingPackageCount} of ${row.packageCount} packages are not on this version`
      : undefined;
  }
  if (row.suppressedPrerelease && row.stableVersion) {
    return `Prerelease ${row.suppressedPrerelease} is older than the stable release ${row.stableVersion}`;
  }
  return undefined;
}

function projectTooltip(row: ProjectVersionRollup): string | undefined {
  return row.laggingPackageCount > 0
    ? `${row.laggingPackageCount} of ${row.packageCount} packages are on older versions`
    : undefined;
}
---

{
  rows.length === 0 ? (
    <p class="border-border bg-surface text-muted rounded-lg border p-6">
      No release data is currently available.
    </p>
  ) : (
    <div class="pv-card overflow-hidden overflow-x-auto">
      <table class="w-full min-w-[44rem] text-left text-sm">
        <thead class="border-border bg-surface/80 border-b backdrop-blur">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold">
              Project
            </th>
            <th scope="col" class="px-4 py-3 font-semibold">
              Stable
            </th>
            <th scope="col" class="px-4 py-3 font-semibold">
              Prerelease
            </th>
            <th scope="col" class="px-4 py-3 font-semibold">
              Latest release
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr
              class="border-border hover:bg-surface/60 border-b last:border-0"
              data-project-id={row.projectId}
              data-project-version={row.stableVersion ?? row.prereleaseVersion ?? ''}
            >
              <td class="px-4 py-3">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={withBase(`/projects/${row.projectId}/`)} class="pv-link font-medium">
                    {row.projectName}
                  </a>
                  <StatusBadge status={row.status} />
                  <span class="pv-chip" title={projectTooltip(row)}>
                    {row.packageCount} package{row.packageCount === 1 ? '' : 's'}
                  </span>
                </div>
              </td>
              <td class="px-4 py-3">
                {row.stableVersion ? (
                  <span class="border-success/30 bg-success/10 text-success inline-flex items-center rounded-full border px-2 py-0.5 font-mono text-xs">
                    {row.stableVersion}
                  </span>
                ) : (
                  <span class="text-muted text-xs">—</span>
                )}
              </td>
              <td class="px-4 py-3">
                {row.prereleaseVersion ? (
                  <span
                    class="border-warning/30 bg-warning/10 text-warning inline-flex items-center rounded-full border px-2 py-0.5 font-mono text-xs"
                    title={prereleaseTooltip(row)}
                  >
                    {row.prereleaseVersion}
                  </span>
                ) : (
                  <span class="text-muted text-xs" title={prereleaseTooltip(row)}>
                    —
                  </span>
                )}
              </td>
              <td class="text-muted px-4 py-3 text-xs">
                {row.latestRelease ? (
                  <a
                    href={row.latestRelease.htmlUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="pv-link font-mono whitespace-nowrap"
                  >
                    {row.latestRelease.tagName}
                  </a>
                ) : (
                  <span class="text-muted">—</span>
                )}
                {row.latestRelease?.publishedAt && (
                  <span class="ml-2 whitespace-nowrap">
                    {formatDate(row.latestRelease.publishedAt)}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
