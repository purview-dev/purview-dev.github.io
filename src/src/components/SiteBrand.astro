---
import { SITE } from '~/lib/site';
import { withBase } from '~/lib/urls';

interface Props {
  /** Compact icon-only mark for dense contexts (default: false). */
  iconOnly?: boolean;
}

const { iconOnly = false } = Astro.props;
---

<a
  href={withBase('/')}
  class="pv-brand flex items-center gap-2.5"
  aria-label={`${SITE.fullName} — home`}
>
  {
    iconOnly ? (
      <img
        src={withBase('/branding/icon.svg')}
        alt=""
        width="28"
        height="28"
        class="h-7 w-7"
      />
    ) : (
      <img
        src={withBase('/branding/logo-horizontal.svg')}
        alt=""
        width="120"
        height="41"
        class="h-9 w-auto"
      />
    )
  }
</a>