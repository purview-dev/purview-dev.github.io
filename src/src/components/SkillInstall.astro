---
import { Code } from '@astrojs/starlight/components';
import { skillEntryPath, skillsInstallCommands } from '~/lib/skills';
import { withBase } from '~/lib/urls';

interface Props {
  /** `owner/repository` the skills are published from. */
  repository: string;
  projectId: string;
  skills: { name: string; description?: string | null }[];
  /** Render the per-skill "fetch it directly" links (default: true). */
  showLinks?: boolean;
}

const { repository, projectId, skills, showLinks = true } = Astro.props;

// One set of instructions for every project that authors skills (ADR 0010).
// The command, the pinning syntax and the lockfile note are identical wherever
// this component renders, so a reader never meets two versions of the truth.
// Each runner is an Expressive Code block, so every command carries the copy
// button — a reader pastes it instead of retyping it.
const commands = skillsInstallCommands(repository);
const defaultCommand = commands[0]!;
---

<div class="rounded-xl border border-border bg-surface p-5 md:p-6">
  <p class="text-sm text-muted">
    Skills are installed explicitly with the
    <a
      href="https://github.com/vercel-labs/skills"
      rel="noopener noreferrer"
      target="_blank"
      class="pv-link">skills CLI</a
    >. Nothing ships them inside a NuGet package, and no build writes into your agent's directories:
    installation is a decision you make. Use whichever package manager you already have.
  </p>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      commands.map((entry) => (
        <div>
          <p class="mb-1 text-xs font-semibold tracking-wider text-muted uppercase">
            {entry.label}
          </p>
          <Code code={entry.command} lang="bash" />
        </div>
      ))
    }
  </div>
  <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-muted">
    <li>
      Installs at project level by default. Add <code>-g</code> for a user-level install, or
      <code>-a &lt;agent&gt;</code> to target one agent.
    </li>
    <li>
      To match the release you use, pin a commit or tag by appending <code>#&lt;ref&gt;</code> to
      any command above (for example <code>{defaultCommand.pinned}</code>).
    </li>
    <li>
      The CLI records what it installed in <code>skills-lock.json</code>; restore it with the same
      runner:
    </li>
  </ul>
  <div class="mt-2">
    <Code code={defaultCommand.restore} lang="bash" />
  </div>
  {
    showLinks && skills.length > 0 && (
      <p class="mt-4 text-sm text-muted">
        Every skill is also published from this site, so a tool or a reviewer can read it without
        cloning the repository:
        <span class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {skills.map((skill) => (
            <a
              href={withBase(skillEntryPath(projectId, skill.name))}
              class="pv-link font-mono text-xs"
            >
              {skill.name}/SKILL.md
            </a>
          ))}
        </span>
      </p>
    )
  }
</div>
