---
import SiteBrand from '~/components/SiteBrand.astro';
import { NAV_ITEMS } from '~/components/SiteNav.astro';
import { loadProjects } from '~/lib/manifest/load';
import { getReleaseInfo } from '~/lib/site-version';
import { OWNER, SITE } from '~/lib/site';
import { withBase } from '~/lib/urls';

// Keep footer links deterministic: the site is static once deployed, so
// build-time randomness would make the output arbitrary rather than fresh.
const footerProjects = loadProjects()
  .filter((project) => project.status !== 'archived')
  .toSorted(
    (a, b) =>
      Number(b.featured) - Number(a.featured) || a.order - b.order || a.name.localeCompare(b.name),
  )
  .slice(0, 3);

const releaseInfo = getReleaseInfo();
const releasesUrl = `${SITE.githubUrl}/${OWNER}.github.io/releases`;
---

<footer class="border-t border-border bg-surface">
  <div class="pv-container py-10">
    <div class="grid gap-8 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]">
      <div class="max-w-sm space-y-3">
        <SiteBrand />
        <p class="text-sm text-muted">
          {SITE.tagline}
          {SITE.orgName} builds developer tooling for .NET — event sourcing, telemetry, validation, source
          generators, and build automation.
        </p>
      </div>

      <nav aria-label="Site">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">Site</h2>
        <ul class="mt-3 list-none space-y-2 text-sm">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={withBase(item.href)} class="pv-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Projects">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">Projects</h2>
        <ul class="mt-3 list-none space-y-2 text-sm">
          {
            footerProjects.map((project) => (
              <li>
                <a href={withBase(`/projects/${project.id}/`)} class="pv-link">
                  {project.name}
                </a>
              </li>
            ))
          }
          <li><a href={withBase('/projects/')} class="pv-link">All projects</a></li>
        </ul>
      </nav>

      <nav aria-label="Community">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">Community</h2>
        <ul class="mt-3 list-none space-y-2 text-sm">
          <li><a href={SITE.githubUrl} class="pv-link">GitHub</a></li>
          <!-- <li><a href={`${SITE.nugetUrl}/search?q=purview`} class="pv-link">NuGet</a></li>
          <li><a href={`${SITE.nugetUrl}/search?q=purview`} class="pv-link">Packages</a></li> -->
          <li><a href={withBase('/about/')} class="pv-link">About</a></li>
        </ul>
      </nav>

      <nav aria-label="For LLMs">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">For LLMs</h2>
        <ul class="mt-3 list-none space-y-2 text-sm">
          <li><a href={withBase('/llms.txt')} class="pv-link">llms.txt</a></li>
          <li><a href={withBase('/llms-small.txt')} class="pv-link">llms-small.txt</a></li>
          <li><a href={withBase('/llms-full.txt')} class="pv-link">llms-full.txt</a></li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-xs text-muted md:flex-row md:items-center"
    >
      <p>© {new Date().getFullYear()} {SITE.orgName}. All public projects are MIT licensed.</p>
      <p class="flex items-center gap-2">
        <span class="beta-badge">Beta</span>
        This site is under active development.
      </p>
      <div class="flex flex-col gap-1">
        <p class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-sm">
          <a href={releasesUrl} class="pv-link" title={`Purview website v${releaseInfo.version}`}>
            v{releaseInfo.version}
          </a>

          <span class="text-muted" aria-hidden="true">·</span>

          <code class="text-muted text-xs" title={`Commit ${releaseInfo.commitSha}`}>
            {releaseInfo.commitSha.slice(0, 7)}
          </code>

          <span class="text-muted" aria-hidden="true">·</span>

          <time
            class="text-muted"
            datetime={releaseInfo.buildDate.toISOString()}
            title={`Built ${releaseInfo.buildDate.toISOString()}`}
          >
            {
              releaseInfo.buildDate.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
              })
            }
          </time>
        </p>
      </div>
      <p class="flex items-center gap-2">
        Built with <span aria-label="love" role="img">💕</span> using
        <a href="https://astro.build" class="pv-link">Astro</a> and <a
          href="https://starlight.astro.build"
          class="pv-link">Starlight</a
        >.
      </p>
    </div>
  </div>
</footer>
