---
import GitHubIcon from '~/components/GitHubIcon.astro';
import StarOnGitHub from '~/components/StarOnGitHub.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import { readDocsManifest } from '~/lib/docs/aggregate';
import { channelBasePath, channelDisplayLabel } from '~/lib/docs/channels';
import { isStale, STALE_AFTER_DAYS } from '~/lib/docs/staleness';
import { projectChannelLlmsFullPath, projectChannelLlmsPath } from '~/lib/discovery/urls';
import { LLMS_LINK_ATTRS } from '~/lib/llms';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { displayStatus } from '~/lib/status';

import { withBase } from '~/lib/urls';

const { entry } = Astro.locals.starlightRoute;
const data = entry?.data;
const lastReviewed = typeof data?.lastReviewed === 'string' ? data.lastReviewed : undefined;
const tags = Array.isArray(data?.tags) ? data.tags : [];
const experimental = data?.experimental === true;
const status = data?.status ? displayStatus({ status: data.status, experimental }) : undefined;

// Documentation channels (ADR 0009): a project may publish a live channel and a
// prerelease one. The switcher is only rendered when the project really has two
// channels, so single-channel projects look exactly as before.
const docsManifest = readDocsManifest();
const sourceProjectId = typeof data?.sourceProject === 'string' ? data.sourceProject : undefined;
const docsProject = docsManifest?.projects.find(
  (project) => project.projectId === sourceProjectId,
);
const channels = docsProject?.channels ?? [];
const activeChannelId = data?.docsChannel;
const activeChannel = channels.find((channel) => channel.id === activeChannelId);
const liveChannel = channels.find((channel) => channel.default);
const showChannelSwitcher = channels.length > 1 && activeChannel !== undefined;
const channelHref = (channelId: 'live' | 'prerelease', isDefault: boolean): string =>
  withBase(channelBasePath(sourceProjectId ?? '', channelId, isDefault));

// A tag-pinned channel does not move, so its review date is the release date:
// flagging it as stale would be noise rather than drift.
const pinnedChannel = activeChannel?.refKind === 'tag';
const stale = lastReviewed && !pinnedChannel ? isStale(lastReviewed) : false;

// A channel's landing page advertises that version's machine-readable bundles.
// A project can publish more than one version (ADR 0009), and each version is a
// whole docs set with its own `llms.txt`, so the link follows the channel the
// reader is on rather than the project's default channel. Other aggregated
// pages keep the heading lean and only link the global files from the site
// footer.
const sourceRepo = typeof data?.sourceRepo === 'string' ? data.sourceRepo : undefined;
// A channel's landing page is the one page whose URL is exactly the channel
// base path; comparing paths keeps this independent of how Starlight names the
// content entry.
const channelPath =
  sourceProjectId !== undefined && activeChannel
    ? withBase(channelBasePath(sourceProjectId, activeChannel.id, activeChannel.default))
    : undefined;
const isChannelIndex =
  channelPath !== undefined &&
  Astro.url.pathname.replace(/\/+$/, '') === channelPath.replace(/\/+$/, '');
const versionLabel = activeChannel
  ? `${data?.projectName ?? sourceProjectId} ${activeChannel.label}`
  : '';
const llmsLinks =
  isChannelIndex && sourceProjectId && activeChannel
    ? [
        {
          label: 'llms.txt',
          href: withBase(
            projectChannelLlmsPath(sourceProjectId, activeChannel.id, activeChannel.default),
          ),
          title: `Machine-readable index for ${versionLabel}`,
        },
        {
          label: 'llms-full.txt',
          href: withBase(
            projectChannelLlmsFullPath(sourceProjectId, activeChannel.id, activeChannel.default),
          ),
          title: `Full machine-readable documentation for ${versionLabel}`,
        },
      ]
    : [];
// Live star count for the owning repository, when the release cache knows it.
const starCount =
  sourceRepo === undefined ?
    null
  : (getReleaseIndex().data.repos[sourceRepo]?.stargazersCount ?? null);
---

<h1 id="_top">{data?.title}</h1>

{
  showChannelSwitcher && activeChannel && (
    <nav class="doc-channels" aria-label="Documentation version">
      <span class="doc-channels-label">Docs for</span>
      <details class="doc-channel-menu">
        <summary>
          {channelDisplayLabel(activeChannel)}
          <span class="doc-channel-caret" aria-hidden="true">
            ▾
          </span>
        </summary>
        <ul class="doc-channel-options">
          {channels.map((channel) => (
            <li>
              <a
                href={channelHref(channel.id, channel.default)}
                class:list={[
                  'doc-channel-option',
                  { 'doc-channel-option-current': channel.id === activeChannelId },
                ]}
                aria-current={channel.id === activeChannelId ? 'page' : undefined}
                title={`Documentation from ${channel.ref}`}
              >
                <span>{channelDisplayLabel(channel)}</span>
                {channel.id === activeChannelId && (
                  <span class="doc-channel-check" aria-hidden="true">
                    ✓
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

{
  activeChannel && !activeChannel.default && liveChannel && (
    <p class="doc-prerelease">
      <strong>Prerelease.</strong> These pages describe {activeChannel.label} and can differ from
      the published release. Read the
      <a href={channelHref(liveChannel.id, true)} class="pv-link">
        {channelDisplayLabel(liveChannel)}
      </a>
      documentation instead.
    </p>
  )
}

{
  data && (
    <div class="doc-meta">
      {
        status && (
          <span class="doc-meta-item">
            <StatusBadge status={status} />
          </span>
        )
      }
      {
        data.sourceProject && (
          <span class="doc-meta-item">
            <a href={withBase(`/projects/${data.sourceProject}/`)} class="pv-link">
              {data.projectName ?? data.sourceProject}
            </a>
          </span>
        )
      }
      {lastReviewed && (
        <span class="doc-meta-item" title={`Last reviewed ${lastReviewed}`}>
          Reviewed {lastReviewed}
          {stale && (
            <span class="stale-badge" title={`Older than ${STALE_AFTER_DAYS} days`}>
              stale
            </span>
          )}
        </span>
      )}
      {
        sourceRepo && (
          <span class="doc-meta-item">
            <a
              href={`https://github.com/${sourceRepo}`}
              rel="noopener noreferrer"
              target="_blank"
              class="pv-link inline-flex items-center gap-1.5"
            >
              <GitHubIcon size={14} />
              {sourceRepo}
            </a>
          </span>
        )
      }
      {
        sourceRepo && (
          <span class="doc-meta-item">
            <StarOnGitHub repository={sourceRepo} stars={starCount} variant="inline" />
          </span>
        )
      }
      {
        tags.length > 0 && (
          <span class="doc-meta-item doc-meta-tags">
            {tags.map((tag) => (
              <span class="doc-tag" title={`Repository topic: ${tag}`}>
                {tag}
              </span>
            ))}
          </span>
        )
      }
      {
        llmsLinks.map((link) => (
          <span class="doc-meta-item">
            <a href={link.href} {...LLMS_LINK_ATTRS} class="pv-link" title={link.title}>
              {link.label}
            </a>
          </span>
        ))
      }
    </div>
  )
}

{
  experimental && (
    <p class="doc-experimental">
      <strong>Experimental.</strong> This project is an experiment: the public API, defaults and
      packaging can change between prereleases, and there is no production support guarantee.
    </p>
  )
}

<style>
  /* Channel switcher (ADR 0009). Rendered only when a project publishes both a
   * live and a prerelease channel. It is a native <details> disclosure so the
   * versions stay reachable without JavaScript: the summary names the channel
   * the reader is on, the menu lists every version, and each option is a real
   * link (middle-click and open-in-new-tab keep working). The current option is
   * marked with aria-current as well as colour. */
  .doc-channels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .doc-channels-label {
    color: var(--sl-color-gray-3);
    margin-right: 0.125rem;
  }

  .doc-channel-menu {
    position: relative;
  }

  .doc-channel-menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    list-style: none;
    border-radius: 9999px;
    border: 1px solid var(--color-brand);
    background-color: color-mix(in oklab, var(--color-brand) 12%, transparent);
    padding: 0.125rem 0.625rem;
    color: var(--color-brand);
    font-weight: 600;
    white-space: nowrap;
  }

  .doc-channel-menu > summary::-webkit-details-marker {
    display: none;
  }

  .doc-channel-menu > summary:hover,
  .doc-channel-menu[open] > summary {
    background-color: color-mix(in oklab, var(--color-brand) 22%, transparent);
  }

  .doc-channel-caret {
    font-size: 0.625rem;
    line-height: 1;
  }

  .doc-channel-options {
    position: absolute;
    z-index: 20;
    margin: 0.375rem 0 0;
    padding: 0.25rem;
    min-width: 100%;
    list-style: none;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-nav, var(--sl-color-black));
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.25);
  }

  .doc-channel-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.375rem;
    padding: 0.1875rem 0.5rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .doc-channel-option:hover {
    background-color: var(--sl-color-gray-6);
    color: var(--color-brand);
  }

  .doc-channel-option-current {
    color: var(--color-brand);
    font-weight: 600;
  }

  .doc-channel-check {
    font-size: 0.6875rem;
  }

  /* Stated in prose as well as in the switcher, so a reader who lands on a
   * prerelease page from search knows which version they are reading. */
  .doc-prerelease {
    margin-top: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--sl-color-orange-high) 40%, transparent);
    background-color: color-mix(in oklab, var(--sl-color-orange-high) 10%, transparent);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }

  .doc-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  /* Standalone warning for an experimental project's documentation (ADR 0004).
   * The badge alone is too easy to miss on a page someone scrolled straight
   * into, so the flag is also stated in prose on every aggregated page. */
  .doc-experimental {
    margin-top: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-error) 40%, transparent);
    background-color: color-mix(in oklab, var(--color-error) 10%, transparent);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .stale-badge {
    margin-left: 0.375rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--sl-color-red-high) 40%, transparent);
    background-color: color-mix(in oklab, var(--sl-color-red-high) 10%, transparent);
    color: var(--sl-color-red-high);
    padding: 0 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .doc-meta-tags {
    flex-wrap: wrap;
    gap: 0.3125rem;
  }

  .doc-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-gray-6);
    padding: 0 0.4375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.25rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
</style>