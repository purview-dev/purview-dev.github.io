---
import GitHubIcon from '~/components/GitHubIcon.astro';
import StarOnGitHub from '~/components/StarOnGitHub.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import { readDocsManifest } from '~/lib/docs/aggregate';
import { channelBasePath, channelDisplayLabel } from '~/lib/docs/channels';
import { isStale, STALE_AFTER_DAYS } from '~/lib/docs/staleness';
import { LLMS_LINK_ATTRS } from '~/lib/llms';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { displayStatus } from '~/lib/status';

import { withBase } from '~/lib/urls';

const { entry } = Astro.locals.starlightRoute;
const data = entry?.data;
const lastReviewed = typeof data?.lastReviewed === 'string' ? data.lastReviewed : undefined;
const tags = Array.isArray(data?.tags) ? data.tags : [];
const experimental = data?.experimental === true;
const status = data?.status ? displayStatus({ status: data.status, experimental }) : undefined;

// Documentation channels (ADR 0009): a project may publish a live channel and a
// prerelease one. The switcher is only rendered when the project really has two
// channels, so single-channel projects look exactly as before.
const docsManifest = readDocsManifest();
const sourceProjectId = typeof data?.sourceProject === 'string' ? data.sourceProject : undefined;
const docsProject = docsManifest?.projects.find(
  (project) => project.projectId === sourceProjectId,
);
const channels = docsProject?.channels ?? [];
const activeChannelId = data?.docsChannel;
const activeChannel = channels.find((channel) => channel.id === activeChannelId);
const liveChannel = channels.find((channel) => channel.default);
const showChannelSwitcher = channels.length > 1 && activeChannel !== undefined;
const channelHref = (channelId: 'live' | 'prerelease', isDefault: boolean): string =>
  withBase(channelBasePath(sourceProjectId ?? '', channelId, isDefault));

// A tag-pinned channel does not move, so its review date is the release date:
// flagging it as stale would be noise rather than drift.
const pinnedChannel = activeChannel?.refKind === 'tag';
const stale = lastReviewed && !pinnedChannel ? isStale(lastReviewed) : false;

// Project overview pages surface the per-project `llms.txt` bundle emitted by
// the discovery integration at /projects/<id>/llms.txt. Other aggregated pages
// keep the heading lean and only link the global files from the site footer.
const entryId = typeof entry?.id === 'string' ? entry.id : undefined;
const isProjectOverview = entryId !== undefined && /^docs\/[^/]+(\/index)?$/.test(entryId);
const sourceProject = typeof data?.sourceProject === 'string' ? data.sourceProject : undefined;
const sourceRepo = typeof data?.sourceRepo === 'string' ? data.sourceRepo : undefined;
// Live star count for the owning repository, when the release cache knows it.
const starCount =
  sourceRepo === undefined ?
    null
  : (getReleaseIndex().data.repos[sourceRepo]?.stargazersCount ?? null);
const llmsHref =
  isProjectOverview && sourceProject ? withBase(`/projects/${sourceProject}/llms.txt`) : null;
---

<h1 id="_top">{data?.title}</h1>

{
  showChannelSwitcher && (
    <nav class="doc-channels" aria-label="Documentation version">
      <span class="doc-channels-label">Docs for</span>
      {channels.map((channel) => (
        <a
          href={channelHref(channel.id, channel.default)}
          class:list={[
            'doc-channel',
            { 'doc-channel-current': channel.id === activeChannelId },
          ]}
          aria-current={channel.id === activeChannelId ? 'page' : undefined}
        >
          {channelDisplayLabel(channel)}
        </a>
      ))}
    </nav>
  )
}

{
  activeChannel && !activeChannel.default && liveChannel && (
    <p class="doc-prerelease">
      <strong>Prerelease.</strong> These pages describe {activeChannel.label} and can differ from
      the published release. Read the
      <a href={channelHref(liveChannel.id, true)} class="pv-link">
        {channelDisplayLabel(liveChannel)}
      </a>
      documentation instead.
    </p>
  )
}

{
  data && (
    <div class="doc-meta">
      {
        status && (
          <span class="doc-meta-item">
            <StatusBadge status={status} />
          </span>
        )
      }
      {
        data.sourceProject && (
          <span class="doc-meta-item">
            <a href={withBase(`/projects/${data.sourceProject}/`)} class="pv-link">
              {data.projectName ?? data.sourceProject}
            </a>
          </span>
        )
      }
      {lastReviewed && (
        <span class="doc-meta-item" title={`Last reviewed ${lastReviewed}`}>
          Reviewed {lastReviewed}
          {stale && (
            <span class="stale-badge" title={`Older than ${STALE_AFTER_DAYS} days`}>
              stale
            </span>
          )}
        </span>
      )}
      {
        sourceRepo && (
          <span class="doc-meta-item">
            <a
              href={`https://github.com/${sourceRepo}`}
              rel="noopener noreferrer"
              target="_blank"
              class="pv-link inline-flex items-center gap-1.5"
            >
              <GitHubIcon size={14} />
              {sourceRepo}
            </a>
          </span>
        )
      }
      {
        sourceRepo && (
          <span class="doc-meta-item">
            <StarOnGitHub repository={sourceRepo} stars={starCount} variant="inline" />
          </span>
        )
      }
      {
        tags.length > 0 && (
          <span class="doc-meta-item doc-meta-tags">
            {tags.map((tag) => (
              <span class="doc-tag" title={`Repository topic: ${tag}`}>
                {tag}
              </span>
            ))}
          </span>
        )
      }
      {
        llmsHref && (
          <span class="doc-meta-item">
            <a
              href={llmsHref}
              {...LLMS_LINK_ATTRS}
              class="pv-link"
              title={`Machine-readable documentation bundle for ${data?.projectName ?? sourceProject}`}
            >
              llms.txt
            </a>
          </span>
        )
      }
    </div>
  )
}

{
  experimental && (
    <p class="doc-experimental">
      <strong>Experimental.</strong> This project is an experiment: the public API, defaults and
      packaging can change between prereleases, and there is no production support guarantee.
    </p>
  )
}

<style>
  /* Channel switcher (ADR 0009). Rendered only when a project publishes both a
   * live and a prerelease channel; the current channel is marked with
   * aria-current as well as colour, and the label reads as prose rather than a
   * bare toggle. */
  .doc-channels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .doc-channels-label {
    color: var(--sl-color-gray-3);
    margin-right: 0.125rem;
  }

  .doc-channel {
    border-radius: 9999px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-gray-6);
    padding: 0.125rem 0.625rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .doc-channel:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .doc-channel-current {
    border-color: var(--color-brand);
    background-color: color-mix(in oklab, var(--color-brand) 12%, transparent);
    color: var(--color-brand);
    font-weight: 600;
  }

  /* Stated in prose as well as in the switcher, so a reader who lands on a
   * prerelease page from search knows which version they are reading. */
  .doc-prerelease {
    margin-top: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--sl-color-orange-high) 40%, transparent);
    background-color: color-mix(in oklab, var(--sl-color-orange-high) 10%, transparent);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }

  .doc-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  /* Standalone warning for an experimental project's documentation (ADR 0004).
   * The badge alone is too easy to miss on a page someone scrolled straight
   * into, so the flag is also stated in prose on every aggregated page. */
  .doc-experimental {
    margin-top: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-error) 40%, transparent);
    background-color: color-mix(in oklab, var(--color-error) 10%, transparent);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .stale-badge {
    margin-left: 0.375rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--sl-color-red-high) 40%, transparent);
    background-color: color-mix(in oklab, var(--sl-color-red-high) 10%, transparent);
    color: var(--sl-color-red-high);
    padding: 0 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .doc-meta-tags {
    flex-wrap: wrap;
    gap: 0.3125rem;
  }

  .doc-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-gray-6);
    padding: 0 0.4375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.25rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
</style>