---
import { withBase } from '~/lib/urls';

export const NAV_ITEMS = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Documentation', href: '/docs/' },
  { label: 'Releases', href: '/releases/' },
  { label: 'About', href: '/about/' },
] as const;

interface Props {
  currentPath: string;
  /** Vertical variant for the mobile menu (default: horizontal). */
  vertical?: boolean;
}

const { currentPath, vertical = false } = Astro.props;

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath === href || currentPath.startsWith(href);
}
---

<ul
  class:list={[
    'list-none',
    vertical ? 'flex flex-col gap-1' : 'hidden items-center gap-1 lg:flex',
  ]}
>
  {
    NAV_ITEMS.map((item) => {
      const active = isActive(withBase(item.href));
      return (
        <li>
          <a
            href={withBase(item.href)}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'block no-underline rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
              active
                ? 'text-brand bg-brand/10'
                : 'text-muted hover:bg-surface hover:text-foreground',
            ]}
          >
            {item.label}
          </a>
        </li>
      );
    })
  }
</ul>