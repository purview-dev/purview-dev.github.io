---
import SiteLayout from '~/layouts/SiteLayout.astro';
import InstallPanel from '~/components/islands/InstallPanel.tsx';
import PackageVersions, { type PackageRow } from '~/components/islands/PackageVersions.tsx';
import StatusBadge from '~/components/StatusBadge.astro';
import UseCaseCard from '~/components/UseCaseCard.astro';
import { buildBadge, nugetDownloadsBadge, nugetVersionBadge, actionsUrl } from '~/lib/badges';
import { installAnchorId, installKindFor, installTabs } from '~/lib/install';
import { LLMS_LINK_ATTRS } from '~/lib/llms';
import { loadProjects } from '~/lib/manifest/load';
import { projectRepoEnrichment } from '~/lib/releases/repo';
import { projectReleaseSummary } from '~/lib/releases/transform';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { SITE } from '~/lib/site';
import { displayStatus } from '~/lib/status';

import { nugetPackageUrl, withBase } from '~/lib/urls';

export function getStaticPaths() {
  return loadProjects().map((project) => ({
    params: { project: project.id },
    props: { project },
  }));
}

interface Props {
  project: ReturnType<typeof loadProjects>[number];
}

const { project } = Astro.props;
const status = displayStatus(project);

const releaseIndex = getReleaseIndex();
const releases = projectReleaseSummary(project, releaseIndex.data, releaseIndex.source);
const { tags, repoDescription } = projectRepoEnrichment(project, releaseIndex.data);
const supplementalRepoDescription =
  (
    repoDescription &&
    repoDescription !== project.shortDescription &&
    repoDescription !== project.description
  ) ?
    repoDescription
  : null;
const related = project.related
  .map((id) => loadProjects().find((candidate) => candidate.id === id))
  .filter((candidate) => candidate !== undefined);
const supersededBy =
  project.supersededBy ?
    loadProjects().find((candidate) => candidate.id === project.supersededBy)
  : undefined;
const primaryPackage = project.packages.find((pkg) => pkg.primary) ?? project.packages[0];
const docsPath = project.docs ? withBase(`/docs/${project.id}/`) : null;
// Per-project machine-readable bundle emitted by `starlight-llms-txt`'s
// `customSets` option (one file per documented project at /_llms-txt/<id>.txt).
const llmsPath = project.docs ? withBase(`/_llms-txt/${project.id}.txt`) : null;
const targetFrameworks = project.targetFrameworks ?? [];
const installSections =
  status !== 'archived' ?
    project.packages.map((pkg) => {
      const release = releases.packages.find((candidate) => candidate.packageId === pkg.id);
      return {
        packageId: pkg.id,
        primary: pkg.primary ?? false,
        tabs: installTabs(
          installKindFor(project),
          pkg.id,
          release?.latestStable ?? release?.latestPrerelease ?? null,
        ),
      };
    })
  : [];
const projectUrl = withBase(`/projects/${project.id}/`);
const hasInstallSections = installSections.length > 0;
const packageRows: PackageRow[] = releases.packages.map((pkg) => ({
  projectId: project.id,
  projectName: project.name,
  projectUrl,
  packageId: pkg.packageId,
  latestStable: pkg.latestStable,
  latestPrerelease: pkg.latestPrerelease,
  totalDownloads: pkg.totalDownloads,
  nugetUrl: pkg.nugetUrl,
  deprecated: pkg.deprecated,
  installAnchor: hasInstallSections ? `#${installAnchorId(pkg.packageId)}` : undefined,
}));
---

<SiteLayout title={`${project.name} — ${SITE.fullName}`} description={project.shortDescription}>
  <div class="pv-container py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <a href={withBase('/projects/')} class="pv-link">Projects</a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground">{project.name}</span>
    </nav>

    <div class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{project.name}</h1>
        <StatusBadge status={status} />
      </div>
      <p class="mt-4 text-lg text-muted">{project.shortDescription}</p>

      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="pv-chip" title={`Repository topic: ${tag}`}>
                {tag}
              </span>
            ))}
          </div>
        )
      }

      {
        status === 'archived' && (
          <div class="mt-6 rounded-lg border border-error/40 bg-error/10 p-4 text-sm">
            <strong>Archived.</strong> This project is no longer actively developed.
            {supersededBy && (
              <>
                {' '}
                It has been superseded by{' '}
                <a href={withBase(`/projects/${supersededBy.id}/`)} class="pv-link">
                  {supersededBy.name}
                </a>
                .
              </>
            )}
          </div>
        )
      }

      {
        status === 'experimental' && (
          <div class="mt-6 rounded-lg border border-error/40 bg-error/10 p-4 text-sm">
            <strong>Experimental.</strong> This project is an experiment: the public API, defaults and
            packaging can change between prereleases, and there is no production support guarantee.
            Read the documentation before adopting it.
          </div>
        )
      }

      <div class="mt-8 flex flex-wrap gap-2">
        <a
          href={project.sourceUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="pv-btn pv-btn-primary pv-btn-sm"
        >
          Source code
        </a>
        {
          docsPath && (
            <a href={docsPath} class="pv-btn pv-btn-secondary pv-btn-sm">
              Documentation
            </a>
          )
        }
        {
          llmsPath && (
            <a
              href={llmsPath}
              {...LLMS_LINK_ATTRS}
              class="pv-btn pv-btn-secondary pv-btn-sm"
              title={`Machine-readable documentation bundle for ${project.name}`}
            >
              llms.txt
            </a>
          )
        }
        <a
          href={project.releasesUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="pv-btn pv-btn-secondary pv-btn-sm"
        >
          Releases
        </a>
        <a
          href={project.issuesUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="pv-btn pv-btn-secondary pv-btn-sm"
        >
          Issues
        </a>
        {
          project.discussionsUrl && (
            <a
              href={project.discussionsUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="pv-btn pv-btn-secondary pv-btn-sm"
            >
              Discussions
            </a>
          )
        }
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-1.5">
        {
          project.status !== 'archived' && (
            <>
              {primaryPackage && (
                <>
                  <a
                    href={nugetPackageUrl(primaryPackage.id)}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="inline-flex"
                  >
                    <img
                      src={nugetVersionBadge(primaryPackage.id)}
                      alt={`NuGet version of ${primaryPackage.id}`}
                      loading="lazy"
                      class="h-5 w-auto"
                    />
                  </a>
                  <a
                    href={nugetPackageUrl(primaryPackage.id)}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="inline-flex"
                  >
                    <img
                      src={nugetDownloadsBadge(primaryPackage.id)}
                      alt={`NuGet downloads of ${primaryPackage.id}`}
                      loading="lazy"
                      class="h-5 w-auto"
                    />
                  </a>
                </>
              )}
              <a
                href={actionsUrl(project.repository)}
                rel="noopener noreferrer"
                target="_blank"
                class="inline-flex"
              >
                <img
                  src={buildBadge(project.repository)}
                  alt={`Build status of ${project.name}`}
                  loading="lazy"
                  class="h-5 w-auto"
                />
              </a>
            </>
          )
        }
      </div>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0 space-y-12">
        {
          project.useCases.length > 0 && (
            <section>
              <h2 class="text-xl font-semibold">Use cases</h2>
              <p class="mt-2 text-muted">
                Concrete examples of what {project.name} does, and who each one is for.
              </p>
              <div class="mt-6 grid gap-5 lg:grid-cols-2">
                {project.useCases.map((useCase) => (
                  <UseCaseCard
                    useCase={useCase}
                    projectName={project.name}
                    projectId={project.id}
                    docsBase={docsPath}
                    showProject={false}
                  />
                ))}
              </div>
            </section>
          )
        }

        <section>
          <h2 class="text-xl font-semibold">The problem</h2>
          <p class="mt-4 leading-relaxed text-muted">{project.description}</p>
          {
            supplementalRepoDescription && (
              <blockquote class="mt-6 border-l-2 border-brand pl-4">
                <p class="text-sm font-medium uppercase tracking-wider text-muted">
                  From the repository
                </p>
                <p class="mt-2 leading-relaxed text-foreground">
                  {supplementalRepoDescription}
                </p>
              </blockquote>
            )
          }
        </section>

        <section>
          <h2 class="text-xl font-semibold">Why it became a project</h2>
          <p class="mt-4 leading-relaxed text-muted">{project.origin}</p>
        </section>

        {
          project.acknowledgments.length > 0 && (
            <section>
              <h2 class="text-xl font-semibold">Acknowledgments</h2>
              <p class="mt-4 leading-relaxed text-muted">
                {project.name} builds on the work of others.
              </p>
              <ul class="mt-4 list-none space-y-3">
                {project.acknowledgments.map((acknowledgment) => (
                  <li class="rounded-xl border border-border bg-surface p-4">
                    <a
                      href={acknowledgment.url}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="pv-link font-medium"
                    >
                      {acknowledgment.name}
                    </a>
                    {acknowledgment.description && (
                      <p class="mt-1 text-sm leading-relaxed text-muted">
                        {acknowledgment.description}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section>
          <h2 class="text-xl font-semibold">Where it fits</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div class="pv-fit-panel rounded-xl p-5">
              <h3 class="pv-fit-panel-title font-semibold">Use it when</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{project.useWhen}</p>
            </div>
            <div class="pv-avoid-panel rounded-xl p-5">
              <h3 class="pv-avoid-panel-title font-semibold">It may not fit when</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{project.avoidWhen}</p>
            </div>
          </div>
        </section>

        {
          project.packages.length > 0 && (
            <section>
              <h2 class="text-xl font-semibold">Packages</h2>
              <div class="mt-4">
                <PackageVersions client:visible packages={packageRows} showProject={false} />
              </div>
            </section>
          )
        }

        {
          installSections.length > 0 && (
            <section>
              <h2 class="text-xl font-semibold">Install</h2>
              <div class="mt-4 space-y-8">
                {installSections.map((install) => (
                  <div id={installAnchorId(install.packageId)} class="scroll-mt-20">
                    {installSections.length > 1 && (
                      <h3 class="flex flex-wrap items-center gap-2 font-mono text-sm font-semibold text-foreground">
                        {install.packageId}
                        {install.primary && (
                          <span class="border-brand/30 bg-brand/5 text-brand pv-chip">primary</span>
                        )}
                      </h3>
                    )}
                    <div class={installSections.length > 1 ? 'mt-2' : ''}>
                      <InstallPanel client:idle tabs={install.tabs} />
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="space-y-6">
        <div class="rounded-xl border border-border bg-surface p-5">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Details</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-muted">Status</dt>
              <dd><StatusBadge status={status} /></dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-muted">Category</dt>
              <dd class="text-right">{project.category}</dd>
            </div>
            {
              targetFrameworks.length > 0 && (
                <div class="flex justify-between gap-3">
                  <dt class="text-muted">Targets</dt>
                  <dd class="text-right font-mono text-xs">{targetFrameworks.join(', ')}</dd>
                </div>
              )
            }
            {
              releases.latestRelease && (
                <div class="flex justify-between gap-3">
                  <dt class="text-muted">Latest release</dt>
                  <dd>
                    <a
                      href={releases.latestRelease.htmlUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="pv-link font-mono text-xs"
                    >
                      {releases.latestRelease.tagName}
                    </a>
                  </dd>
                </div>
              )
            }
            <div class="flex justify-between gap-3">
              <dt class="text-muted">Repository</dt>
              <dd class="text-right font-mono text-xs">{project.repository}</dd>
            </div>
          </dl>
        </div>

        {
          related.length > 0 && (
            <div class="rounded-xl border border-border bg-surface p-5">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Related</h2>
              <ul class="mt-4 list-none space-y-2 text-sm">
                {related.map((relatedProject) => (
                  <li>
                    <a href={withBase(`/projects/${relatedProject.id}/`)} class="pv-link">
                      {relatedProject.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="text-xs text-muted">
          Release data retrieved {
            releases.retrievedAt ?
              `on ${releases.retrievedAt.slice(0, 10)}`
            : 'from committed fixtures'
          }.
        </p>
      </aside>
    </div>
  </div>
</SiteLayout>
