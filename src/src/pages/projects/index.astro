---
import SiteLayout from '~/layouts/SiteLayout.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ProjectFilter from '~/components/islands/ProjectFilter.tsx';
import StatusBadge from '~/components/StatusBadge.astro';
import { loadExternalProjects, loadProjects } from '~/lib/manifest/load';
import { projectRepoEnrichment } from '~/lib/releases/repo';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { SITE } from '~/lib/site';

const projects = loadProjects();
const externalProjects = loadExternalProjects();
const releaseIndex = getReleaseIndex();
const categories = [...new Set(projects.map((project) => project.category))].toSorted();
const statuses = ['stable', 'preview'];
---

<SiteLayout
  title={`Projects — ${SITE.fullName}`}
  description="The Purview-Dev product family: event sourcing, telemetry, validation, source generators, and build automation for .NET."
>
  <div class="pv-container py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Catalogue</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Projects</h1>
      <p class="mt-4 text-lg text-muted">
        The complete Purview-Dev product family — open source, MIT licensed, and published to NuGet.
        Every project is documented and actively developed.
      </p>
    </div>

    <div class="mt-8">
      <ProjectFilter client:visible categories={categories} statuses={statuses} />
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => {
          const { tags } = projectRepoEnrichment(project, releaseIndex.data);
          return (
            <div
              data-project-id={project.id}
              data-category={project.category}
              data-status={project.status}
              data-search={`${project.name} ${project.shortDescription} ${tags.join(' ')} ${project.category} ${project.status}`.toLowerCase()}
            >
              <ProjectCard project={project} />
            </div>
          );
        })
      }
    </div>

    {
      externalProjects.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Collaborations</h2>
          <p class="mt-2 max-w-2xl text-muted">
            Open-source projects outside the Purview organisation that the team helps build. They
            link to their own sites and repositories.
          </p>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {externalProjects.map((project) => (
              <a
                href={project.url}
                rel="noopener noreferrer"
                target="_blank"
                class="pv-card pv-card-interactive flex flex-col gap-3 p-5 no-underline"
              >
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-lg font-semibold leading-snug">{project.name}</h3>
                  {project.status && <StatusBadge status={project.status} />}
                </div>
                <p class="text-sm text-muted">{project.shortDescription}</p>
                <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
                  <span class="pv-chip">{project.category}</span>
                  <span class="pv-chip">External ↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</SiteLayout>
