---
import SiteLayout from '~/layouts/SiteLayout.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ProjectVersionSnapshot from '~/components/ProjectVersionSnapshot.astro';
import UseCaseCard from '~/components/UseCaseCard.astro';
import { loadProjects } from '~/lib/manifest/load';
import { projectReleaseSummary, projectVersionRollup } from '~/lib/releases/transform';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { SITE } from '~/lib/site';
import { absoluteUrl, withBase } from '~/lib/urls';

const projects = loadProjects();
const featured = projects.filter((project) => project.featured);
const active = projects.filter((project) => project.status !== 'archived');
const featuredGridClass = `featured-projects-grid${featured.length === 5 ? ' featured-projects-grid-five' : ''}`;

// A short, concrete taste of the catalogue: the first use case from the first
// few featured projects that carry one. The full, filterable list lives at
// /use-cases/.
const examples = featured
  .flatMap((project) => {
    const useCase = project.useCases[0];
    return useCase ? [{ project, useCase }] : [];
  })
  .slice(0, 3);

const releaseIndex = getReleaseIndex();
const versionRows = active.map((project) =>
  projectVersionRollup(
    project,
    projectReleaseSummary(project, releaseIndex.data, releaseIndex.source),
  ),
);

const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.orgName,
  url: SITE.url,
  logo: absoluteUrl('/branding/icon-light-512.png'),
  description: SITE.description,
  sameAs: [SITE.githubUrl, `${SITE.nugetUrl}/search?q=purview`],
};
---

<SiteLayout
  title={`${SITE.fullName} — .NET developer tooling`}
  description={SITE.description}
  structuredData={organizationStructuredData}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img
        src={withBase('/branding/banner.svg')}
        alt=""
        class="h-full w-full object-cover opacity-40"
        width="1280"
        height="320"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-background/30 via-background/70 to-background"
      >
      </div>
    </div>
    <div class="pv-container pt-16 pb-10 md:pt-24 md:pb-12">
      <div class="max-w-3xl">
        <p
          class="mb-6 flex flex-wrap items-center gap-2 rounded-lg border border-border bg-surface/80 px-4 py-2.5 text-sm text-muted backdrop-blur"
        >
          <span class="beta-badge">Beta</span>
          This site is in beta — release data and documentation are refreshed from the source repositories
          on an ongoing basis.
        </p>
        <p class="pv-chip mb-5 border-brand/30 bg-brand/5 text-brand">
          {SITE.tagline}
        </p>
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
          .NET tooling shaped by real work.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted">
          Purview is where I turn repeated engineering problems into open-source tools — removing
          boilerplate, catching mistakes earlier, and automating the work developers shouldn't
          have to keep doing by hand.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/projects/')} class="pv-btn pv-btn-primary"> Browse projects </a>
          <a href={withBase('/docs/')} class="pv-btn pv-btn-secondary"> Read the documentation </a>
          <a href={withBase('/releases/')} class="pv-btn pv-btn-ghost">
            View releases
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pv-container py-10 md:py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <h2 class="text-xl font-semibold">Automate the repetition</h2>
        <p class="mt-3 text-muted">
          If a problem is predictable and repeatable, I would rather solve it once in tooling than
          ask developers to remember the same manual steps forever.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Catch problems earlier</h2>
        <p class="mt-3 text-muted">
          Source generation and compile-time validation feature heavily because clear feedback
          during development is better than reflection, runtime wiring, and late surprises.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Adopt only what helps</h2>
        <p class="mt-3 text-muted">
          Each project should stand on its own. Use one because it solves a problem you have, then
          combine projects where their shared conventions genuinely add value.
        </p>
      </div>
    </div>
  </section>

  {
    examples.length > 0 && (
      <section class="pv-container pb-10 md:pb-12" aria-labelledby="in-practice-heading">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 id="in-practice-heading" class="text-2xl font-bold tracking-tight md:text-3xl">
              What it looks like in practice
            </h2>
            <p class="mt-2 max-w-2xl text-muted">
              Concrete examples drawn from the projects — the code you write, and what the tooling
              gives you back.
            </p>
          </div>
          <a href={withBase('/use-cases/')} class="pv-link hidden shrink-0 sm:inline">
            All use cases →
          </a>
        </div>
        <div class="mt-8 grid gap-5 lg:grid-cols-2">
          {examples.map(({ project, useCase }, index) => (
            <div
              class:list={[
                'min-w-0',
                examples.length % 2 === 1 && index === examples.length - 1 && 'lg:col-span-2',
              ]}
            >
              <UseCaseCard
                useCase={useCase}
                projectName={project.name}
                projectId={project.id}
                docsBase={project.docs ? withBase(`/docs/${project.id}/`) : null}
              />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="pv-container pb-10 md:pb-12">
    <div class="rounded-xl border border-brand/20 bg-brand/5 px-6 py-6 md:flex md:items-center md:justify-between md:gap-8 md:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-wider text-muted">The principle</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight">Automation, not operation.</h2>
        <p class="mt-3 text-muted">
          Purview grew from solving the same real-world engineering problems repeatedly. If the
          work is predictable, I want the tooling to handle it—not another checklist for developers
          to operate by hand.
        </p>
      </div>
      <a href={withBase('/about/')} class="pv-link mt-5 inline-block shrink-0 md:mt-0">
        Why I started building Purview →
      </a>
    </div>
  </section>

  <section class="pv-container pb-10 md:pb-12">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Featured projects</h2>
        <p class="mt-2 max-w-2xl text-muted">
          A selection of the tools that have grown from repeated problems in real .NET projects.
        </p>
      </div>
      <a href={withBase('/projects/')} class="pv-link hidden shrink-0 sm:inline">
        View all projects →
      </a>
    </div>
    <div class={featuredGridClass}>
      {
        featured.map((project) => (
          <div class="featured-project-card">
            <ProjectCard project={project} showBadges={false} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="pv-container py-10 md:py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Package status</h2>
        <p class="mt-2 max-w-2xl text-muted">
          See the latest stable and prerelease versions across active projects. This summary rolls
          each project's packages into one row; the releases page has the full package-level view.
        </p>
      </div>
      <a href={withBase('/releases/')} class="pv-link hidden shrink-0 sm:inline">
        Package versions on the releases page →
      </a>
    </div>
    <div class="mt-8">
      <ProjectVersionSnapshot rows={versionRows} />
    </div>
    <p class="mt-3 text-xs text-muted">
      Release data retrieved on {releaseIndex.data.retrievedAt.slice(0, 10)} ({releaseIndex.source} source).
    </p>
  </section>

  <section class="border-y border-border bg-surface/60">
    <div class="pv-container py-12 md:py-16">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Find the tool that fits</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-border p-6">
          <p class="text-sm font-semibold text-brand">1 · Start with the problem</p>
          <p class="mt-2 text-muted">
            Explore {active.length} active projects covering generation, validation, telemetry,
            event sourcing, Aspire, and build automation.
          </p>
        </div>
        <div class="rounded-xl border border-border p-6">
          <p class="text-sm font-semibold text-brand">2 · Adopt one piece</p>
          <p class="mt-2 text-muted">
            Purview is not an all-or-nothing stack. Add the package that helps, without replacing
            choices that already work for your application.
          </p>
        </div>
        <div class="rounded-xl border border-border p-6">
          <p class="text-sm font-semibold text-brand">3 · Go deeper when needed</p>
          <p class="mt-2 text-muted">
            The documentation is brought together from each project's repository, so guides,
            examples, and technical detail stay close to the code they describe.
          </p>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={withBase('/projects/')} class="pv-btn pv-btn-primary"> Open the catalogue </a>
        <a
          href={SITE.githubUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="pv-btn pv-btn-secondary"
        >
          Visit the GitHub organisation
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .featured-projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: stretch;
  }

  .featured-project-card {
    display: flex;
    flex: 1 1 100%;
    min-width: 0;
  }

  .featured-project-card :global(.pv-card) {
    width: 100%;
  }

  @media (min-width: 640px) {
    .featured-project-card {
      flex-basis: calc((100% - 1.25rem) / 2);
    }

    .featured-projects-grid-five .featured-project-card:last-child {
      flex-basis: 100%;
    }
  }

  @media (min-width: 1024px) {
    .featured-project-card {
      flex-basis: calc((100% - 3.75rem) / 4);
    }

    .featured-projects-grid-five .featured-project-card {
      flex-basis: calc((100% - 2.5rem) / 3);
    }

    .featured-projects-grid-five .featured-project-card:nth-child(n + 4) {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }
</style>
