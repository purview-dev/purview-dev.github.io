---
import SiteLayout from '~/layouts/SiteLayout.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import PackageVersions, { type PackageRow } from '~/components/islands/PackageVersions.tsx';
import { loadProjects } from '~/lib/manifest/load';
import { projectReleaseSummary } from '~/lib/releases/transform';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { SITE } from '~/lib/site';
import { absoluteUrl, withBase } from '~/lib/urls';

const projects = loadProjects();
const featured = projects.filter((project) => project.featured);
const active = projects.filter((project) => project.status !== 'archived');
const featuredGridClass = `featured-projects-grid${featured.length === 5 ? ' featured-projects-grid-five' : ''}`;

const releaseIndex = getReleaseIndex();
const packageRows: PackageRow[] = projects
  .filter((project) => project.status !== 'archived')
  .flatMap((project) => {
    const summary = projectReleaseSummary(project, releaseIndex.data, releaseIndex.source);
    return summary.packages.map((pkg) => ({
      projectId: summary.projectId,
      projectName: summary.projectName,
      packageId: pkg.packageId,
      latestStable: pkg.latestStable,
      latestPrerelease: pkg.latestPrerelease,
      totalDownloads: pkg.totalDownloads,
      nugetUrl: pkg.nugetUrl,
      projectUrl: withBase(`/projects/${summary.projectId}/`),
    }));
  });

const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.orgName,
  url: SITE.url,
  logo: absoluteUrl('/branding/icon-light-512.png'),
  description: SITE.description,
  sameAs: [SITE.githubUrl, `${SITE.nugetUrl}/search?q=purview`],
};
---

<SiteLayout
  title={`${SITE.fullName} — .NET developer tooling`}
  description={SITE.description}
  structuredData={organizationStructuredData}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img
        src={withBase('/branding/banner.svg')}
        alt=""
        class="h-full w-full object-cover opacity-40"
        width="1280"
        height="320"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-background/30 via-background/70 to-background"
      >
      </div>
    </div>
    <div class="pv-container py-20 md:py-28">
      <div class="max-w-3xl">
        <p
          class="mb-6 flex flex-wrap items-center gap-2 rounded-lg border border-border bg-surface/80 px-4 py-2.5 text-sm text-muted backdrop-blur"
        >
          <span class="beta-badge">Beta</span>
          This site is in beta — release data and documentation are refreshed from the source repositories
          on an ongoing basis.
        </p>
        <p class="pv-chip mb-5 border-brand/30 bg-brand/5 text-brand">
          {SITE.tagline}
        </p>
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
          Developer tooling for .NET that gets out of your way.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted">
          Purview Dev builds the pieces that .NET projects need but rarely want to write by hand —
          event sourcing, telemetry, schema validation, source generators, and build automation —
          designed to be fast, typed, and painless to adopt.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/projects/')} class="pv-btn pv-btn-primary"> Browse projects </a>
          <a href={withBase('/docs/')} class="pv-btn pv-btn-secondary"> Read the documentation </a>
          <a href={withBase('/releases/')} class="pv-btn pv-btn-ghost">
            View releases
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pv-container py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <h2 class="text-xl font-semibold">Source generators, done deliberately</h2>
        <p class="mt-3 text-muted">
          Several Purview projects are built on Roslyn source generators to move work from runtime
          to compile time — zero allocations, no reflection, and APIs that are impossible to wire up
          wrong.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-semibold">One coherent product family</h2>
        <p class="mt-3 text-muted">
          The projects share conventions, a common build pipeline ({`Purview.Build`}), and
          integration points — for example
          {`Purview.EventSourcing`} validates aggregates with {`Purview.ZodSharp`}.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Provider-agnostic by design</h2>
        <p class="mt-3 text-muted">
          Storage, serialization, and validation choices stay swappable. Adopt the parts you need
          without rewriting the parts you already have.
        </p>
      </div>
    </div>
  </section>

  <section class="pv-container pb-16 md:pb-20">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Featured projects</h2>
        <p class="mt-2 max-w-2xl text-muted">
          The foundations of the Purview product family. Every project is open source, MIT licensed,
          and published to NuGet.
        </p>
      </div>
      <a href={withBase('/projects/')} class="pv-link hidden shrink-0 sm:inline">
        View all projects →
      </a>
    </div>
    <div class={featuredGridClass}>
      {
        featured.map((project) => (
          <div class="featured-project-card">
            <ProjectCard project={project} showBadges={false} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="pv-container py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Package status</h2>
        <p class="mt-2 max-w-2xl text-muted">
          The latest stable and prerelease version of every NuGet package at a glance. Search, or
          click a column to sort.
        </p>
      </div>
      <a href={withBase('/releases/')} class="pv-link hidden shrink-0 sm:inline">
        View all releases →
      </a>
    </div>
    <div class="mt-8">
      <PackageVersions client:visible packages={packageRows} />
    </div>
    <p class="mt-3 text-xs text-muted">
      Release data retrieved on {releaseIndex.data.retrievedAt.slice(0, 10)} ({releaseIndex.source} source).
    </p>
  </section>

  <section class="border-y border-border bg-surface/60">
    <div class="pv-container py-16 md:py-20">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Start building today</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-border p-6">
          <p class="text-sm font-semibold text-brand">1 · Pick a project</p>
          <p class="mt-2 text-muted">
            Explore the {active.length} active projects in the catalogue and find the one that solves
            your problem.
          </p>
        </div>
        <div class="rounded-xl border border-border p-6">
          <p class="text-sm font-semibold text-brand">2 · Add the package</p>
          <p class="mt-2 text-muted">
            Every project ships real NuGet packages. {`dotnet add package`} and a source generator or
            two is usually all it takes.
          </p>
        </div>
        <div class="rounded-xl border border-border p-6">
          <p class="text-sm font-semibold text-brand">3 · Read the docs</p>
          <p class="mt-2 text-muted">
            Full documentation is aggregated here from each repository — guides, provider matrices,
            guarantees, and examples.
          </p>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={withBase('/projects/')} class="pv-btn pv-btn-primary"> Open the catalogue </a>
        <a
          href={SITE.githubUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="pv-btn pv-btn-secondary"
        >
          Visit the GitHub organisation
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .featured-projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: stretch;
  }

  .featured-project-card {
    display: flex;
    flex: 1 1 100%;
    min-width: 0;
  }

  .featured-project-card :global(.pv-card) {
    width: 100%;
  }

  @media (min-width: 640px) {
    .featured-project-card {
      flex-basis: calc((100% - 1.25rem) / 2);
    }

    .featured-projects-grid-five .featured-project-card:last-child {
      flex-basis: 100%;
    }
  }

  @media (min-width: 1024px) {
    .featured-project-card {
      flex-basis: calc((100% - 3.75rem) / 4);
    }

    .featured-projects-grid-five .featured-project-card {
      flex-basis: calc((100% - 2.5rem) / 3);
    }

    .featured-projects-grid-five .featured-project-card:nth-child(n + 4) {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }
</style>
