---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { SITE } from '~/lib/site';
import { withBase } from '~/lib/urls';
---

<SiteLayout
  title={`Page not found — ${SITE.fullName}`}
  description="The page you were looking for could not be found."
>
  <div class="pv-container flex flex-col items-center py-24 text-center md:py-32">
    <p class="pv-chip mb-6 border-brand/30 bg-brand/5 text-brand">404</p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
      This page seems to have evaporated.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">
      The URL you followed does not exist on {SITE.domain}. The beaker may have bubbled over — or
      the link may be out of date.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={withBase('/')} class="pv-btn pv-btn-primary"> Back to the homepage </a>
      <a href={withBase('/projects/')} class="pv-btn pv-btn-secondary"> Browse projects </a>
      <a href={withBase('/docs/')} class="pv-btn pv-btn-ghost"> Documentation </a>
    </div>
  </div>
</SiteLayout>
