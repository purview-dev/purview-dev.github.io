---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { getHubs, hubHref } from '~/lib/hubs';
import { SITE } from '~/lib/site';
import { absoluteUrl, withBase } from '~/lib/urls';

const { categories, topics } = getHubs();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Categories',
  description: 'The categories the Purview .NET projects belong to.',
  url: absoluteUrl('/categories/'),
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: SITE.fullName, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.orgName, url: SITE.url },
};
---

<SiteLayout
  title={`Categories — Purview .NET projects | ${SITE.fullName}`}
  description="Purview's open-source .NET projects grouped by category — source generation, validation, observability, Aspire, build tooling and application frameworks."
  structuredData={structuredData}
>
  <div class="pv-container py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <a href={withBase('/')} class="pv-link">Home</a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground">Categories</span>
    </nav>

    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Categories</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Categories</h1>
      <p class="mt-4 text-lg text-muted">
        What the projects are for, rather than what they are tagged with. Open a category for the
        projects in it and the documentation they publish.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((hub) => (
          <div class="pv-card flex flex-col gap-3 p-5">
            <h2 class="text-lg font-semibold leading-snug">
              <a href={hubHref(hub)} class="pv-link">
                {hub.label}
              </a>
            </h2>
            <ul class="mt-1 list-none space-y-1 text-sm">
              {hub.projects.map((project) => (
                <li>
                  <a href={withBase(project.url)} class="pv-link">
                    {project.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <section class="mt-12 rounded-xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-xl font-semibold">Browse by topic instead</h2>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        <a href={withBase('/topics/')} class="pv-link">Topics</a> slice the same projects by the
        technology they use{
          topics.length > 0
            ? ` — ${topics
                .slice(0, 5)
                .map((hub) => hub.label.toLowerCase())
                .join(', ')} and more.`
            : '.'
        }
      </p>
    </section>
  </div>
</SiteLayout>
