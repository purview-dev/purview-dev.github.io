---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { LLMS_LINK_ATTRS } from '~/lib/llms';
import { loadProjects } from '~/lib/manifest/load';
import { readDocsManifest } from '~/lib/docs/aggregate';
import { projectRepoEnrichment } from '~/lib/releases/repo';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { SITE } from '~/lib/site';
import { withBase } from '~/lib/urls';

const projects = loadProjects().filter(
  (project) => project.docs && project.status !== 'archived',
);
const releaseIndex = getReleaseIndex();
const docsManifest = readDocsManifest();
const pageCount = docsManifest?.projects.reduce(
  (total, entry) => total + entry.pages.length,
  0,
);
---

<SiteLayout
  title={`Documentation — ${SITE.fullName}`}
  description="Searchable documentation for Purview's .NET projects, brought together from the repositories that own it."
>
  <div class="pv-container py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Documentation</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Documentation</h1>
      <p class="mt-4 text-lg text-muted">
        I keep documentation with the project it describes, then bring it together here so you can
        search and explore it in one place — {pageCount ?? 0} pages across {projects.length} projects.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => {
          const entry = docsManifest?.projects.find((item) => item.projectId === project.id);
          const { tags } = projectRepoEnrichment(project, releaseIndex.data);
          return (
            <a
              href={withBase(`/docs/${project.id}/`)}
              class="pv-card pv-card-interactive flex flex-col gap-3 p-5 no-underline"
            >
              <h2 class="text-lg font-semibold leading-snug">{project.name}</h2>
              <p class="text-sm text-muted">{project.shortDescription}</p>
              {
                tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {tags.slice(0, 4).map((tag) => (
                      <span class="pv-chip">{tag}</span>
                    ))}
                  </div>
                )
              }
              <p class="mt-auto pt-2 text-sm text-accent">
                {entry?.pages.length ?? 0} page{(entry?.pages.length ?? 0) === 1 ? '' : 's'} →
              </p>
            </a>
          );
        })
      }
    </div>

    <section class="mt-16 rounded-xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-xl font-semibold">Kept close to the code</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted">
        <li>
          Each page identifies its owning project, lifecycle status, and last review date.
        </li>
        <li>
          Source links take you back to the repository where an issue or edit can be raised.
        </li>
        <li>
          Search spans the full site, including projects, releases, and documentation.
        </li>
      </ul>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-xl font-semibold">Machine-readable documentation</h2>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        Each project's documentation is also published as a single <code>llms.txt</code> bundle for
        language models and other tooling. The whole site is available as
        <a href={withBase('/llms.txt')} {...LLMS_LINK_ATTRS} class="pv-link">llms.txt</a>,
        <a href={withBase('/llms-small.txt')} {...LLMS_LINK_ATTRS} class="pv-link">
          llms-small.txt
        </a>, and
        <a href={withBase('/llms-full.txt')} {...LLMS_LINK_ATTRS} class="pv-link">
          llms-full.txt
        </a>.
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          projects.map((project) => (
            <li>
              <a
                href={withBase(`/projects/${project.id}/llms.txt`)}
                {...LLMS_LINK_ATTRS}
                class="pv-link"
              >
                {project.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</SiteLayout>
