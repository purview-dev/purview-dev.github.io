---
import SkillInstall from '~/components/SkillInstall.astro';
import SiteLayout from '~/layouts/SiteLayout.astro';
import { loadProjects } from '~/lib/manifest/load';
import { SITE } from '~/lib/site';
import { listMirroredSkills, skillEntryPath } from '~/lib/skills';
import { withBase } from '~/lib/urls';

// Skills are authored per repository (`skills/<name>/SKILL.md`) and installed
// with the skills CLI. This page publishes every mirrored skill from
// purview.dev and prints exactly the same instructions for each repository, so
// there is one install story for the whole suite (ADR 0010).
const groups = loadProjects()
  .filter((project) => listMirroredSkills(project.id).length > 0 && project.status !== 'archived')
  .toSorted((a, b) => a.order - b.order || a.name.localeCompare(b.name))
  .map((project) => ({
    project,
    // The published list is what the sync discovered at the project's own ref,
    // never the manifest text — a new skill appears after the next sync.
    skills: listMirroredSkills(project.id).map((skill) => ({
      name: skill.name,
      description: skill.description ?? '',
      files: skill.files.length,
    })),
  }));
const skillCount = groups.reduce((total, group) => total + group.skills.length, 0);
---

<SiteLayout
  title={`Agent skills — ${SITE.fullName}`}
  description="Agent Skills published by Purview projects, with one set of installation instructions for every repository."
>
  <div class="pv-container py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Agent skills</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Agent skills</h1>
      <p class="mt-4 text-lg text-muted">
        {skillCount} skills across {groups.length} project{groups.length === 1 ? '' : 's'}. Each project
        authors its own skills at <code>skills/&lt;name&gt;/SKILL.md</code> and installs them with the
        skills CLI. The instructions below are identical for every repository, and every skill is
        also published here so it can be read or fetched from purview.dev.
      </p>
      <p class="mt-3 text-sm text-muted">
        Machine-readable index: <a href={withBase('/skills.json')} class="pv-link">/skills.json</a>.
        Skills are never shipped inside a NuGet package and no build writes into your agent's
        directories.
      </p>
    </div>

    <div class="mt-10 space-y-12">
      {
        groups.map(({ project, skills }) => (
          <section>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-2xl font-semibold">
                <a href={withBase(`/projects/${project.id}/`)} class="pv-link">
                  {project.name}
                </a>
              </h2>
              <a
                href={project.sourceUrl}
                rel="noopener noreferrer"
                target="_blank"
                class="font-mono text-xs text-muted pv-link"
              >
                {project.repository}
              </a>
            </div>
            <p class="mt-1 text-sm text-muted">{project.shortDescription}</p>

            <div class="mt-4">
              <SkillInstall
                repository={project.repository}
                projectId={project.id}
                skills={skills}
                showLinks={false}
              />
            </div>

            <ul class="mt-5 divide-y divide-border rounded-xl border border-border">
              {skills.map((skill) => (
                <li class="flex flex-col gap-1 p-4 sm:flex-row sm:items-baseline sm:justify-between">
                  <div>
                    <a
                      href={withBase(skillEntryPath(project.id, skill.name))}
                      class="pv-link font-mono text-sm"
                    >
                      {skill.name}
                    </a>
                    {skill.description && (
                      <p class="mt-1 max-w-2xl text-sm text-muted">{skill.description}</p>
                    )}
                  </div>
                  <span class="shrink-0 text-xs text-muted">
                    {skill.files} file{skill.files === 1 ? '' : 's'}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</SiteLayout>
