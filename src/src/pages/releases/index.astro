---
import SiteLayout from '~/layouts/SiteLayout.astro';
import ReleaseFilter from '~/components/islands/ReleaseFilter.tsx';
import ReleaseOverview, {
  type ReleaseOverviewRow,
} from '~/components/islands/ReleaseOverview.tsx';
import PackageVersions, { type PackageRow } from '~/components/islands/PackageVersions.tsx';
import { loadProjects } from '~/lib/manifest/load';
import { effectivePrerelease } from '~/lib/releases/normalize';
import { projectRepoEnrichment } from '~/lib/releases/repo';
import { flattenReleases, projectReleaseSummary } from '~/lib/releases/transform';
import { getReleaseIndex } from '~/lib/releases/runtime';
import { listMirroredSkills } from '~/lib/skills';
import { SITE } from '~/lib/site';
import { displayStatus } from '~/lib/status';
import { withBase } from '~/lib/urls';

const projects = loadProjects();
const activeProjectIds = new Set(
  projects.filter((project) => project.status !== 'archived').map((project) => project.id),
);
const releaseIndex = getReleaseIndex();
const summaries = projects.map((project) =>
  projectReleaseSummary(project, releaseIndex.data, releaseIndex.source),
);
const releases = flattenReleases(summaries).filter((entry) => !entry.archived);
const projectOptions = projects
  .filter((project) => project.status !== 'archived' && project.packages.length > 0)
  .map((project) => ({ id: project.id, name: project.name }));
// Detailed, per-package rows for the sortable/groupable table below. The home
// page shows the rolled-up per-project snapshot instead.
const packageRows: PackageRow[] = summaries
  .filter((summary) => activeProjectIds.has(summary.projectId))
  .flatMap((summary) =>
    summary.packages.map((pkg) => ({
      projectId: summary.projectId,
      projectName: summary.projectName,
      packageId: pkg.packageId,
      registry: pkg.registry,
      latestStable: pkg.latestStable,
      // Only surface a prerelease that outranks the stable release, so a
      // trailing prerelease never sits beside a newer stable version.
      latestPrerelease: effectivePrerelease(pkg.latestStable, pkg.latestPrerelease),
      downloads: pkg.downloads,
      downloadsPeriod: pkg.downloadsPeriod,
      packageUrl: pkg.packageUrl,
      projectUrl: withBase(`/projects/${summary.projectId}/`),
      deprecated: pkg.deprecated,
    })),
  );

// The releases quick view: one card per active project, in catalogue order, with
// the build-time package versions behind each row so the browser can re-check
// them against NuGet/npm (ADR 0008, ADR 0012).
const summaryById = new Map(summaries.map((summary) => [summary.projectId, summary]));
const overviewRows: ReleaseOverviewRow[] = projects
  .filter((project) => project.status !== 'archived')
  .map((project) => {
    const packages = summaryById.get(project.id)?.packages ?? [];
    const periods = new Set(packages.map((pkg) => pkg.downloadsPeriod));
    const downloads = packages.reduce(
      (sum, pkg) => (pkg.downloads == null ? sum : sum + pkg.downloads),
      0,
    );
    const hasDownloads = packages.some((pkg) => pkg.downloads != null);
    const latestRelease = summaryById.get(project.id)?.latestRelease ?? null;
    return {
      projectId: project.id,
      projectName: project.name,
      projectUrl: withBase(`/projects/${project.id}/`),
      docsUrl: project.docs ? withBase(`/docs/${project.id}/`) : null,
      repositoryUrl: project.sourceUrl,
      status: displayStatus(project),
      category: project.category,
      packageCount: packages.length,
      skillCount: listMirroredSkills(project.id).length,
      packages: packages.map((pkg) => ({
        id: pkg.packageId,
        registry: pkg.registry,
        stable: pkg.latestStable,
        prerelease: effectivePrerelease(pkg.latestStable, pkg.latestPrerelease),
      })),
      latestRelease:
        latestRelease === null
          ? null
          : {
              tagName: latestRelease.tagName,
              url: latestRelease.htmlUrl,
              publishedAt: latestRelease.publishedAt,
            },
      // Only mix download counts from one registry: NuGet reports totals, npm
      // reports a weekly figure, so a sum across both would be meaningless.
      downloads: hasDownloads && periods.size === 1 ? downloads : null,
      downloadsPeriod: periods.size === 1 ? [...periods][0]! : 'total',
      tags: projectRepoEnrichment(project, releaseIndex.data).tags,
    };
  });

function formatDate(value: string | null): string {
  if (!value) {
    return 'Unknown date';
  }
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? 'Unknown date'
    : date.toLocaleDateString('en-GB', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
}
---

<SiteLayout
  title={`Releases — ${SITE.fullName}`}
  description="Current GitHub releases and package versions across Purview's projects, on NuGet and npm."
>
  <div class="pv-container py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="pv-chip mb-4 border-brand/30 bg-brand/5 text-brand">Releases</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Releases</h1>
      <p class="mt-4 text-lg text-muted">
        Every Purview project on one page: the versions it publishes today, re-checked against NuGet
        and npm in your browser, with the recent GitHub releases and the package-level detail below.
      </p>
    </div>

    <section class="mt-10" aria-labelledby="project-versions-heading">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="project-versions-heading" class="text-2xl font-bold tracking-tight md:text-3xl">
            Project versions
          </h2>
          <p class="mt-2 max-w-2xl text-muted">
            One card per project, rolled up from its packages. The versions re-check the package
            registries in your browser, so a release published after this build still shows up.
          </p>
        </div>
        <p class="text-muted shrink-0 text-xs">
          Data retrieved {releaseIndex.data.retrievedAt.slice(0, 10)} ({releaseIndex.source} source).
        </p>
      </div>

      <div class="mt-6">
        <ReleaseOverview client:visible rows={overviewRows} />
      </div>
    </section>

    <section class="mt-16" aria-labelledby="recent-releases-heading">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="recent-releases-heading" class="text-2xl font-bold tracking-tight md:text-3xl">
            Latest GitHub releases
          </h2>
          <p class="mt-2 max-w-2xl text-muted">
            The newest published GitHub release per project, with enough context to find the release
            that matters to you.
          </p>
        </div>
        <ReleaseFilter client:visible projects={projectOptions} />
      </div>

      <div class="mt-8 space-y-4">
      {
        releases.length === 0 && (
          <p class="rounded-lg border border-border bg-surface p-6 text-muted">
            No release data is currently available.
            {
              releaseIndex.source === 'fixture' && (
                <> This build is using committed sample fixtures; run `just fetch-releases` for live data.</>
              )
            }
          </p>
        )
      }
      {
        releases.map((release) => (
          <article
            data-release-project={release.projectId}
            data-release-prerelease={release.prerelease}
            class="pv-card flex flex-col gap-4 p-5 sm:flex-row sm:items-start sm:justify-between"
          >
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 text-sm">
                <a
                  href={withBase(`/projects/${release.projectId}/`)}
                  class="font-semibold text-accent hover:underline"
                >
                  {release.projectName}
                </a>
                {
                  release.prerelease && (
                    <span class="rounded-full border border-warning/40 bg-warning/10 px-2 py-0.5 text-xs text-warning">
                      prerelease
                    </span>
                  )
                }
              </div>
              <h3 class="mt-2 text-xl font-bold tracking-tight md:text-2xl">
                <a
                  href={release.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="block truncate font-mono hover:text-accent hover:underline"
                >
                  {release.tagName}
                </a>
              </h3>
              {
                release.repoDescription && (
                  <p class="mt-2 max-w-2xl text-sm text-muted">
                    {release.repoDescription}
                  </p>
                )
              }
              {
                release.tags.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {release.tags.slice(0, 6).map((tag) => (
                      <span class="pv-chip">{tag}</span>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="shrink-0 text-sm text-muted sm:text-right">
              <time datetime={release.publishedAt ?? undefined}>{formatDate(release.publishedAt)}</time>
            </div>
          </article>
        ))
      }
      </div>
    </section>

    <section class="mt-16" aria-labelledby="package-versions-heading">
      <h2 id="package-versions-heading" class="text-xl font-semibold">Package versions</h2>
      <p class="mt-2 max-w-2xl text-muted">
        A package-level view sourced from NuGet and npm at build time. Search the list, group packages by
        project, or sort a column to compare versions and downloads.
      </p>
      <div class="mt-6">
        <PackageVersions client:visible packages={packageRows} />
      </div>
      <p class="mt-3 text-xs text-muted">
        Release data retrieved on {releaseIndex.data.retrievedAt.slice(0, 10)} ({releaseIndex.source} source).
      </p>
    </section>
  </div>
</SiteLayout>
