---
import StatusBadge from '~/components/StatusBadge.astro';
import type { ResolvedProject } from '~/lib/manifest/load';
import { withBase } from '~/lib/urls';

interface Props {
  project: ResolvedProject;
}

const { project } = Astro.props;
---

<a
  href={withBase(`/projects/${project.id}/`)}
  class="pv-card pv-card-interactive flex flex-col gap-3 p-5"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold leading-snug">{project.name}</h3>
    <StatusBadge status={project.status} />
  </div>
  <p class="text-sm text-muted">{project.shortDescription}</p>
  <div class="mt-auto flex items-center gap-2 pt-2">
    <span class="pv-chip">{project.category}</span>
    {
      project.packages.length > 0 && (
        <span class="pv-chip">
          {project.packages.length} package{project.packages.length === 1 ? '' : 's'}
        </span>
      )
    }
  </div>
</a>