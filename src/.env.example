# Purview-Dev website environment variables.
# Copy to `.env` for local overrides. All values are optional.

# Canonical site URL used for canonical tags, sitemap, and social metadata.
# Defaults to https://purview.dev
SITE_URL=https://purview.dev

# Astro base path. Leave "/" for a custom domain or organisation Pages site.
# For project-level GitHub Pages (e.g. https://purview-dev.github.io/purview-dev/)
# set PAGES_BASE=/purview-dev/
PAGES_BASE=/

# Optional GitHub token to raise API rate limits when fetching release data.
# Never commit a real token. Omit for anonymous access in local development.
GITHUB_TOKEN=

# Release/docs data source mode:
#   auto    - use cached data if present, otherwise fetch live, otherwise fixtures
#   live    - always fetch from GitHub/NuGet
#   cache   - only use cached data (fails if cache is missing)
#   fixture - only use committed fixtures (offline, deterministic)
DATA_MODE=auto

# When DATA_MODE=auto and live fetching fails, fall back to committed fixtures
# instead of failing the build. Set to false to fail loudly instead.
DATA_FALLBACK_TO_FIXTURES=true